# Yemen Wedding AI — Environment Configuration
# Copy to .env.local and fill in your actual API keys

# ========== APP CONFIG ==========
NEXT_PUBLIC_APP_URL=https://yemenwedding.ai
NEXT_PUBLIC_APP_NAME="Yemen Wedding AI"
NEXT_PUBLIC_APP_VERSION=2.0.0

# ========== SUPABASE ==========
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ========== AUTH ==========
NEXTAUTH_URL=https://yemenwedding.ai
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple OAuth
APPLE_CLIENT_ID=com.yemenwedding.app
APPLE_CLIENT_SECRET=your-apple-client-secret

# ========== AI PROVIDERS ==========
# Replicate (Primary) — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...

# Leonardo AI — https://app.leonardo.ai/settings
LEONARDO_API_KEY=your-leonardo-api-key

# Stability AI — https://platform.stability.ai/account/keys
STABILITY_API_KEY=sk-...

# ========== STRIPE ==========
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Price IDs
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_YEARLY=price_...
STRIPE_PRICE_VIP_MONTHLY=price_...
STRIPE_PRICE_VIP_YEARLY=price_...

# ========== CLOUD STORAGE ==========
# Cloudflare R2 (or AWS S3)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=yemen-wedding-images
R2_PUBLIC_URL=https://images.yemenwedding.ai

# ========== MONITORING ==========
# Sentry
SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...

# LogRocket
NEXT_PUBLIC_LOGROCKET_APP_ID=your-app/logrocket-id

# ========== FEATURE FLAGS ==========
NEXT_PUBLIC_ENABLE_LEONARDO=true
NEXT_PUBLIC_ENABLE_STABILITY=true
NEXT_PUBLIC_ENABLE_VIDEO_GEN=false
NEXT_PUBLIC_ENABLE_CUSTOM_LORA=false

# ========== RATE LIMITING ==========
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token
